#!/usr/bin/bash
set -e

CODENAME="jclic"
DEFAULT_URL="file:///usr/share/jclic/index.html"
APP_URL="${DEFAULT_URL}"

# Traitement du paramètre éventuel (fichier local ou URL)
if [ -n "$1" ]; then
    if [ -f "$1" ]; then
        ABS_PATH=$(realpath "$1")
        APP_URL="file:///usr/share/jclic/index.html?project=${ABS_PATH}"
    elif [[ "$1" =~ ^https?:// ]] || [[ "$1" =~ ^file:// ]]; then
        APP_URL="file:///usr/share/jclic/index.html?project=$1"
    fi
fi

ICE_DIR="${HOME}/.local/share/ice"
FIREFOX_PROFILE="${ICE_DIR}/firefox/${CODENAME}"
USER_APPS_DIR="${HOME}/.local/share/applications"
USER_DESKTOP_FILE="${USER_APPS_DIR}/webapp-${CODENAME}.desktop"
USER_ICONS_DIR="${ICE_DIR}/icons"

mkdir -p "${FIREFOX_PROFILE}/chrome"
mkdir -p "${USER_APPS_DIR}"
mkdir -p "${USER_ICONS_DIR}"

# 1. Configuration du profil Firefox : barre de titre système native activée, barres internes masquées
cat << 'EOF' > "${FIREFOX_PROFILE}/user.js"
user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);
user_pref("browser.tabs.inTitlebar", 0);
user_pref("browser.tabs.warnOnClose", false);
user_pref("browser.shell.checkDefaultBrowser", false);
user_pref("browser.startup.page", 0);
user_pref("browser.startup.homepage_override.mstone", "ignore");
user_pref("security.fileuri.strict_origin_policy", false);
EOF

cat << 'EOF' > "${FIREFOX_PROFILE}/chrome/userChrome.css"
#nav-bar,
#identity-box,
#TabsToolbar {
    visibility: collapse !important;
}
EOF

# 2. S'assurer que le fichier desktop pour WebApp Manager existe dans ~/.local/share/applications/
if [ ! -f "${USER_DESKTOP_FILE}" ]; then
    if [ -f "/usr/share/applications/webapp-${CODENAME}.desktop" ]; then
        cp -a "/usr/share/applications/webapp-${CODENAME}.desktop" "${USER_DESKTOP_FILE}"
    fi
fi

# Copier l'icône dans le dossier icons de WebApp Manager
if [ ! -f "${USER_ICONS_DIR}/${CODENAME}.png" ] && [ -f "/usr/share/pixmaps/${CODENAME}.png" ]; then
    cp -a "/usr/share/pixmaps/${CODENAME}.png" "${USER_ICONS_DIR}/${CODENAME}.png"
fi

# 3. Forcer l'identité distincte dans le dock/barre des tâches (X11 et Wayland)
export MOZ_APP_REMOTINGNAME="WebApp-${CODENAME}"
export MOZ_WAYLAND_APP_ID="WebApp-${CODENAME}"
export XAPP_FORCE_GTKWINDOW_ICON="${CODENAME}"

# 4. Lancement de Firefox avec sa classe de fenêtre dédiée
if command -v firefox >/dev/null 2>&1; then
    exec firefox --class "WebApp-${CODENAME}" --name "WebApp-${CODENAME}" --profile "${FIREFOX_PROFILE}" --no-remote "${APP_URL}"
else
    exec xdg-open "${APP_URL}"
fi
